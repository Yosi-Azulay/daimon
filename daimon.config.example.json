{
  "searchRoots": [
    "D:\\Synology\\SourceCode\\my-nx-workspace",
    { "path": "D:\\Synology\\SourceCode\\vite-projects", "viteSubfolders": true }
  ],
  "portRange": [4200, 4299],
  "apiPort": 4999,

  "ports": {
    "pool": null
  },

  "autoStart": [],
  "profiles": {
    "fullstack": ["web-admin", "api"]
  },
  "tags": {
    "web-admin": ["frontend"],
    "api": ["backend"]
  },
  "depends": {
    "web-admin": ["api"]
  },
  "cascadeRestart": false,

  "healthProbe": {
    "enabled": true,
    "intervalMs": 30000,
    "timeoutMs": 2000,
    "path": "/",
    "host": null,
    "scheme": null,
    "rejectUnauthorized": false,
    "fallbackHosts": ["127.0.0.1", "::1"]
  },

  "autoRestart": {
    "enabled": false,
    "maxAttempts": 5,
    "windowMs": 300000
  },

  "history": {
    "enabled": true,
    "path": "~/.daimon/history.db",
    "retentionDays": 30
  },

  "output": {
    "format": "compact",
    "ndjson": false
  },

  "dashboard": {
    "theme": "auto",
    "density": "comfortable"
  },

  "doctor": {
    "autoFix": {
      "onInit": false,
      "permitted": ["orphan-daemon", "stale-lock", "missing-search-root", "corrupt-history-db"]
    }
  },

  "notifications": {
    "enabled": true,
    "onError": true,
    "onUnhealthy": true,
    "tray": false,
    "kinds": ["error", "unhealthy", "stale", "compile-regression", "bundle-regression", "task-fail"],
    "quietHours": null,
    "batchMs": 300000
  },

  "webhooks": [
    {
      "url": "https://hooks.slack.com/services/T000/B000/XXXXXXXX",
      "events": ["error", "regression-detected", "status"],
      "headers": { "x-extra-header": "optional-value" },
      "filter": { "app": ["web-admin"], "to": ["error", "unhealthy"], "from": [] },
      "digest": "09:00"
    }
  ],

  "frameworks": [],

  "tests": { "flakyThreshold": 3 },
  "restartStorm": { "perHour": 20 },
  "search": { "logIndex": true },

  "staleDetect": {
    "enabled": true,
    "silentMs": 30000
  },

  "logs": {
    "enabled": false,
    "dir": "~/.daimon/logs",
    "maxFiles": 5,
    "maxBytesPerFile": 10000000
  },

  "envFiles": {},

  "requestLog": { "enabled": false, "portOffset": 1000 },
  "metrics": { "enabled": false },
  "headless": false,

  "overrides": {
    "web-admin": {
      "port": 4250,
      "command": "npx nx serve web-admin --configuration=dev",
      "env": { "API_BASE": "http://localhost:3000" },
      "url": null,
      "compileRegressionFactor": 2.0,
      "testCommand": "npx nx test web-admin",
      "logIndex": true
    }
  }
}
