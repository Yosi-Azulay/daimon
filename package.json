{
  "name": "bosun",
  "version": "0.4.2",
  "description": "Local dev-server manager for Angular/Nx/Vite/Storybook — TUI, loopback HTTP API, JSON CLI, and MCP server for Claude Code",
  "type": "module",
  "bin": {
    "bosun": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src/dashboard.html",
    "src/templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/main.js",
    "cli": "node dist/cli.js",
    "mcp": "node dist/mcp.js",
    "test": "node --test test/depends.test.mjs test/bundle.test.mjs test/notifier.test.mjs test/regression.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.10.0",
    "fast-glob": "^3.3.2",
    "ink": "^5.0.1",
    "ink-select-input": "^6.0.0",
    "ink-text-input": "^6.0.0",
    "node-notifier": "^10.0.1",
    "pidusage": "^4.0.1",
    "react": "^18.3.1",
    "strip-ansi": "^7.1.0",
    "tree-kill": "^1.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "typescript": "^5.5.4"
  }
}
