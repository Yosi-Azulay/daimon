{
  "apps": [
    {
      "name": "flask",
      "profile": "flask",
      "command": "flask run"
    }
  ],
  "parse": {
    "startup": [
      " * Serving Flask app \"app\"",
      " * Debug mode: on",
      " * Running on http://127.0.0.1:5000",
      "Press CTRL+C to quit"
    ],
    "expectStatus": "serving",
    "expectUrl": "http://127.0.0.1:5000",
    "errors": [
      "Traceback (most recent call last):",
      "  File \"/app/app.py\", line 9, in hello",
      "    return render_template(\"index.html\", user=current_user)",
      "NameError: name \"current_user\" is not defined"
    ],
    "expectError": {
      "file": "/app/app.py",
      "line": 9
    }
  },
  "logLines": [
    {
      "raw": "[2026-07-17 10:00:00,123] ERROR in app: Exception on /users [GET]",
      "level": "error"
    },
    {
      "raw": "ERROR:flask.app:unhandled exception during request",
      "level": "error"
    },
    {
      "raw": "WARNING: This is a development server. Do not use it in a production deployment.",
      "level": "warn"
    },
    {
      "raw": "INFO:werkzeug:127.0.0.1 - - [17/Jul/2026 10:00:00] \"GET / HTTP/1.1\" 200 -",
      "level": "info"
    },
    {
      "raw": "DEBUG:app:loaded configuration from .flaskenv",
      "level": "debug"
    },
    {
      "raw": " * Running on http://127.0.0.1:5000",
      "level": null
    }
  ]
}
