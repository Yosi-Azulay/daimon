#compdef daimon
# daimon zsh completion — generated from src/cliSurface.ts. Do not hand-edit;
# regenerate with: npm run build && npm run build:completions
# install: daimon completion zsh > "${fpath[1]}/_daimon"  (or source it from .zshrc)
_daimon() {
  local -a verbs
  verbs=('agents:Roster of agents touching this daemon\: id, last-seen, action counts, held soft-' 'audit:Query the audit trail\: who did what, when. Derives { ts, agent, action, app, ch' 'ci:CI helper\: start a profile and block until all apps are healthy. Designed for G' 'claude:Install/update Claude Code integration artifacts.' 'clean:Remove build artifacts for an app.' 'completion:Emit a shell completion script for the given shell.' 'config:Validate a daimon config against the known-key schema\: unknown keys warn with t' 'context:Agent context pack\: status/framework/uptime, top error groups, last crash, last' 'daemon:Manage the daimon daemon.' 'dashboard:Open the dashboard in your default browser, scoped to the current cwd.' 'discover:Run discovery read-only. Prints _meta\: searchRoots, scanned, rejected per folde' 'doctor:Sanity-check config + env. --auto-fix repairs orphan daemon, stale lock, missing' 'down:Stop a group, a profile, or all apps. Groups resolve first and stop members in r' 'ensure:One-call\: start if needed, block to target state, return terminal state. Idempo' 'ensure-up:One-call\: cascade-start every app in the profile and wait for each to reach tar' 'env:Env-file awareness\: convention files (found/missing), key names, snapshot age; ' 'errors:Get deduplicated errors for an app. Compact by default ({file,line,col,code,mess' 'events:Get the event log. --stream emits NDJSON until SIGINT.' 'export:One-way carry-out bundle\: events, error groups, test runs, compiles, crashes (b' 'export-config:Emit the active config to stdout. --redacted replaces apiToken with "<redacted>"' 'focus:One round-trip subscribe-then-act\: streams NDJSON of status/error/url events fo' 'frameworks:List framework profiles (built-in + custom)\: detection markers, command, which ' 'free-port:Diagnose / free a port.' 'graph:READ-ONLY view of the depends graph\: nodes (status/health/workspace/groups), ed' 'handoff:Transfer the soft-lock on <app> to another agent.' 'history:Summary metrics (uptime%, restarts, compile p50/p95, top errors).' 'init:Create daimon.config.json in cwd from a real discovery scan of this folder; --ye' 'list:List apps. Compact by default; --full for v0.4 shape; --stream for NDJSON; --exp' 'log:alias → logs' 'logs:Recent log lines for an app. --level filters by classified level; --grep filters' 'ls:alias → list' 'mute:Mute OS notifications for an app (optionally for a duration). Persisted; shown i' 'orchestrate:Bring up a whole profile in one call\: cascade-start, wait for goal, run ONE try' 'overview:Decision-ready snapshot\: totals, byStatus, needsAttention (with first parsed er' 'pin-health:Show the auto-discovered health-probe path for an app; --accept persists it as o' 'plugin:Manage plug-ins (Plugin API v1)\: list, show one, validate a file offline.' 'plugins:List loaded plug-ins\: name, apiVersion, status (active|disabled|load-error), ho' 'ports:Port map\: app → port → source (pinned|pool|announced) → pid, plus foreign holde' 'profiles:Suggest profile candidates from recurring co-starts.' 'ps:alias → status' 'record:Toggle session recording.' 'replay:Replay a recorded session.' 'report:The digest\: per-app uptime, errors (new/recurring/resolved), test pass-rate + f' 'restart:Restart an app. --steal overrides another agent''s soft-lock.' 'run:Run a discovered task.' 'search:Full-text search over everything daimon has seen\: log lines, errors, and events' 'self:Print daimon''s own runtime metrics (pid, version, uptime, rss, heap, event-loop' 'sessions:Walk history by daemon-uptime slice. Each session is DERIVED from the daemon-sta' 'snapshot:Write a snapshot of app state to ~/.daimon/snapshots.' 'start:Start an app. --steal overrides another agent''s soft-lock.' 'status:Get the current status of one app (compact by default), or of a whole group with' 'stop:Stop an app. --steal overrides another agent''s soft-lock. A name matching no ap' 'tasks:List discovered non-serve tasks.' 'test:Run the app''s own test suite once\: resolves the runner (vitest/jest/pytest/go/' 'test-history:Recent test runs for an app (totals, exit codes, gitHead, failures). --flaky lis' 'timeline:Print a unified chronological event timeline.' 'top:Live resource table\: app → pid → rss → cpu → uptime, sorted by RSS. Watch-and-w' 'try-fix:Composite\: run doctor --auto-fix on permitted rules, restart the app, wait for ' 'unmute:Lift a notification mute.' 'up:Start a group or profile (or autoStart). Groups resolve first\: depends-aware to' 'wait:Block until app reaches the given state.' 'why:One-shot forensics\: status, last crash (exit code + final log lines), grouped 2' 'why-empty:Explain why `daimon list` is empty\: configured searchRoots, scanned/rejected co' 'workspaces:Manage the workspace registry (searchRoots).')
  if (( CURRENT == 2 )); then
    _describe 'command' verbs
    return
  fi
  if [[ ${words[CURRENT-1]} == --app ]]; then
    local -a apps
    apps=(${(f)"$(daimon --no-spawn list --compact 2>/dev/null | node -e "try{let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{try{JSON.parse(s).forEach(a=>console.log(a.name||''))}catch(e){}})}catch(e){}" 2>/dev/null)"})
    compadd -a apps
    return
  fi
  local canon=${words[2]}
  case $canon in
    ls) canon=list ;;
    ps) canon=status ;;
    log) canon=logs ;;
    profiles) canon=profiles ;;
    config) canon=config ;;
  esac
  if (( CURRENT == 3 )); then
    local -a cands
    case $canon in
      ci) cands=(start) ;;
      claude) cands=(install update uninstall status) ;;
      completion) cands=(bash zsh fish powershell) ;;
      config) cands=(validate) ;;
      daemon) cands=(start stop status restart attach install-service) ;;
      env) cands=(diff) ;;
      plugin) cands=(list show validate) ;;
      profiles) cands=(suggest) ;;
      workspaces) cands=(list add rm show) ;;
    esac
    case $canon in
      clean|context|ensure|env|errors|focus|handoff|history|logs|mute|pin-health|restart|run|snapshot|start|status|stop|tasks|test|test-history|try-fix|unmute|wait|why)
        cands+=(${(f)"$(daimon --no-spawn list --compact 2>/dev/null | node -e "try{let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{try{JSON.parse(s).forEach(a=>console.log(a.name||''))}catch(e){}})}catch(e){}" 2>/dev/null)"})
        ;;
    esac
    if (( ${#cands} )); then
      compadd -a cands
      return
    fi
  fi
  if [[ $canon == env && ${words[3]} == diff && CURRENT == 4 ]]; then
    local -a apps
    apps=(${(f)"$(daimon --no-spawn list --compact 2>/dev/null | node -e "try{let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{try{JSON.parse(s).forEach(a=>console.log(a.name||''))}catch(e){}})}catch(e){}" 2>/dev/null)"})
    compadd -a apps
    return
  fi
  local -a flags
  case $canon in
    agents) flags=(--json --help --no-color --no-spawn) ;;
    audit) flags=(--agent --app --since --limit --json --help --no-color --no-spawn) ;;
    ci) flags=(--until --timeout --json --help --no-color --no-spawn) ;;
    claude) flags=(--help --no-color --no-spawn) ;;
    clean) flags=(--deep --yes --help --no-color --no-spawn) ;;
    completion) flags=(--help --no-color --no-spawn) ;;
    config) flags=(--help --no-color --no-spawn) ;;
    context) flags=(--budget --help --no-color --no-spawn) ;;
    daemon) flags=(--detach --headless --help --no-color --no-spawn) ;;
    dashboard) flags=(--help --no-color --no-spawn) ;;
    discover) flags=(--help --no-color --no-spawn) ;;
    doctor) flags=(--auto-fix --dry-run --self --help --no-color --no-spawn) ;;
    down) flags=(--steal --help --no-color --no-spawn) ;;
    ensure) flags=(--until --timeout --help --no-color --no-spawn) ;;
    ensure-up) flags=(--until --timeout --help --no-color --no-spawn) ;;
    env) flags=(--from --to --use --help --no-color --no-spawn) ;;
    errors) flags=(--group --workspace --since --since-last --client --structured --full --compact --help --no-color --no-spawn) ;;
    events) flags=(--since --app --stream --help --no-color --no-spawn) ;;
    export) flags=(--since --app --format --out --help --no-color --no-spawn) ;;
    export-config) flags=(--redacted --help --no-color --no-spawn) ;;
    focus) flags=(--until --timeout --help --no-color --no-spawn) ;;
    frameworks) flags=(--help --no-color --no-spawn) ;;
    free-port) flags=(--force --help --no-color --no-spawn) ;;
    graph) flags=(--json --workspace --all --help --no-color --no-spawn) ;;
    handoff) flags=(--help --no-color --no-spawn) ;;
    history) flags=(--help --no-color --no-spawn) ;;
    init) flags=(--yes --force --auto --help --no-color --no-spawn) ;;
    list) flags=(--tag --workspace --group --full --compact --stream --explain --help --no-color --no-spawn) ;;
    logs) flags=(--tail --since --level --grep --stream --group --help --no-color --no-spawn) ;;
    mute) flags=(--for --help --no-color --no-spawn) ;;
    orchestrate) flags=(--goal --timeout --dry-run --budget --help --no-color --no-spawn) ;;
    overview) flags=(--workspace --profile --budget --help --no-color --no-spawn) ;;
    pin-health) flags=(--accept --path --help --no-color --no-spawn) ;;
    plugin) flags=(--help --no-color --no-spawn) ;;
    plugins) flags=(--json --help --no-color --no-spawn) ;;
    ports) flags=(--help --no-color --no-spawn) ;;
    profiles) flags=(--help --no-color --no-spawn) ;;
    record) flags=(--help --no-color --no-spawn) ;;
    replay) flags=(--speed --help --no-color --no-spawn) ;;
    report) flags=(--since --app --workspace --group --md --help --no-color --no-spawn) ;;
    restart) flags=(--steal --help --no-color --no-spawn) ;;
    run) flags=(--watch --help --no-color --no-spawn) ;;
    search) flags=(--app --workspace --since --kind --limit --help --no-color --no-spawn) ;;
    self) flags=(--help --no-color --no-spawn) ;;
    sessions) flags=(--since --json --help --no-color --no-spawn) ;;
    snapshot) flags=(--help --no-color --no-spawn) ;;
    start) flags=(--with-deps --steal --help --no-color --no-spawn) ;;
    status) flags=(--full --compact --group --help --no-color --no-spawn) ;;
    stop) flags=(--steal --help --no-color --no-spawn) ;;
    tasks) flags=(--help --no-color --no-spawn) ;;
    test) flags=(--failed --timeout --steal --json --help --no-color --no-spawn) ;;
    test-history) flags=(--flaky --limit --help --no-color --no-spawn) ;;
    timeline) flags=(--help --no-color --no-spawn) ;;
    top) flags=(--json --help --no-color --no-spawn) ;;
    try-fix) flags=(--until --timeout --help --no-color --no-spawn) ;;
    unmute) flags=(--help --no-color --no-spawn) ;;
    up) flags=(--until --timeout --steal --dry-run --help --no-color --no-spawn) ;;
    wait) flags=(--until --timeout --help --no-color --no-spawn) ;;
    why) flags=(--help --no-color --no-spawn) ;;
    why-empty) flags=(--help --no-color --no-spawn) ;;
    workspaces) flags=(--help --no-color --no-spawn) ;;
  esac
  flags+=(--help --no-color --no-spawn)
  compadd -a flags
}
compdef _daimon daimon
